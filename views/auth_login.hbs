<h2>Entrar</h2>

<form id="login-form" action="/pages/login" method="post">
  <label>Email
    <input type="email" name="email" required>
  </label>
  <label>Senha
    <input type="password" name="password" required>
  </label>
  <button type="submit">Entrar</button>
</form>
<p>Não tem conta? <a href="/pages/register">Crie uma</a></p>
