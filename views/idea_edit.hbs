<h2>Editar ideia</h2>

<form id="idea-edit-form" action="/api/ideas/{{idea.id}}?_method=PUT" method="post">
  <label>Título
    <input type="text" name="title" value="{{idea.title}}" required>
  </label>
  <label>Descrição
    <textarea name="description" rows="6" required>{{idea.description}}</textarea>
  </label>
  <label>Categoria
    <input type="text" name="category" value="{{idea.category}}">
  </label>
  <button type="submit">Salvar</button>
</form>
