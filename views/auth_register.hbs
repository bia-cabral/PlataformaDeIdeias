<h2>Cadastrar</h2>

<form id="register-form" action="/pages/register" method="post">
  <label>Nome
    <input type="text" name="name" required>
  </label>
  <label>Email
    <input type="email" name="email" required>
  </label>
  <label>Senha
    <input type="password" name="password" required>
  </label>
  <button type="submit">Cadastrar</button>
</form>
<p><a href="/pages/login">Voltar ao login</a></p>
