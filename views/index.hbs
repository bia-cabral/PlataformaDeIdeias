<h2>Ideias</h2>

<div class="actions-bar d-flex align-items-center justify-content-between mb-3">
  <a class="btn btn-primary" href="/pages/ideas/new">Nova ideia</a>

  <form action="/pages/ideas" method="get" class="search-form d-flex ms-auto" style="gap:.5rem;">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <input class="form-control" type="text" name="search" placeholder="Pesquisar por título..." value="{{searchTerm}}">
    <select name="category" class="form-select">
      <option value="" {{#unless selectedCategory}}selected{{/unless}}>Todas as categorias</option>
      {{#each categories}}
        <option value="{{id}}" {{#if (eq ../selectedCategory (string id))}}selected{{/if}}>{{name}}</option>
      {{/each}}
    </select>
    <button type="submit" class="btn btn-outline-primary">Buscar</button>
  </form>
</div>

<div class="ideas-list">
  {{#if ideas}}
    {{#each ideas}}
      <article class="idea-card">
        <h3><a href="/pages/ideas/{{id}}">{{title}}</a></h3>
        <p>{{description}}</p>
        <div class="meta">
          <span>Autor: {{authorName}}</span>
          <span>Categoria: {{category.name}}</span>
          <span>Favor: {{upvotes}}</span>
          <span>Contra: {{downvotes}}</span>
          <span>Total: {{votesCount}}</span>
        </div>
        <form action="/pages/ideas/{{id}}/vote" method="post" class="vote-form d-inline-block me-1">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <input type="hidden" name="vote_value" value="1" />
          <button type="submit" class="btn btn-sm btn-success" {{#if voted}}disabled{{/if}}>Votar a favor</button>
        </form>
        <form action="/pages/ideas/{{id}}/vote" method="post" class="vote-form d-inline-block">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <input type="hidden" name="vote_value" value="0" />
          <button type="submit" class="btn btn-sm btn-danger" {{#if voted}}disabled{{/if}}>Votar contra</button>
        </form>
      </article>
    {{/each}}
  {{else}}
    <p>Nenhuma ideia registrada ainda.</p>
  {{/if}}
</div>
