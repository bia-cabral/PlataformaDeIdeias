<h2>Ideias</h2>

<a class="btn" href="/pages/ideas/new">Nova ideia</a>

<div class="ideas-list">
  {{#if ideas}}
    {{#each ideas}}
      <article class="idea-card">
        <h3><a href="/pages/ideas/{{id}}">{{title}}</a></h3>
        <p>{{description}}</p>
        <div class="meta">
          <span>Autor: {{authorName}}</span>
          <span>Favor: {{upvotes}}</span>
          <span>Contra: {{downvotes}}</span>
          <span>Total: {{votesCount}}</span>
        </div>
        <form action="/pages/ideas/{{id}}/vote" method="post" class="vote-form" style="display:inline-block;">
          <input type="hidden" name="vote_value" value="1" />
          <button type="submit" {{#if voted}}disabled{{/if}}>Votar a favor</button>
        </form>
        <form action="/pages/ideas/{{id}}/vote" method="post" class="vote-form" style="display:inline-block;">
          <input type="hidden" name="vote_value" value="0" />
          <button type="submit" {{#if voted}}disabled{{/if}}>Votar contra</button>
        </form>
      </article>
    {{/each}}
  {{else}}
    <p>Nenhuma ideia registrada ainda.</p>
  {{/if}}
</div>
